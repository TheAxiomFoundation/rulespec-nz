  "mode": "read_only_local_files",
  "purpose": "Repository-side contract for reading local Parquet layers from corpus-legislation-nz and corpus-nz-hansard, then promoting selected normalized JSON/JSONL corpus artifacts into rulespec-nz.",
  "sources": [
    {
      "id": "corpus-legislation-nz",
      "name": "Corpus Legislation NZ local Parquet export",
      "status": "expected_local_external",
      "payload_format": "parquet",
      "local_path_env": "RULESPEC_NZ_CORPUS_LEGISLATION_PARQUET_DIR",
      "canonical_source_id": "nz-legislation",
      "legal_authority": "official_legislation",
      "role": "Local columnar mirror of official NZ legislation provision text for source locator, coverage, and RuleSpec provenance joins.",
      "never_commit_payloads": true
    },
    {
      "id": "corpus-nz-hansard",
      "name": "Corpus NZ Hansard local Parquet export",
      "status": "expected_local_external",
      "payload_format": "parquet",
      "local_path_env": "RULESPEC_NZ_CORPUS_HANSARD_PARQUET_DIR",
      "canonical_source_id": "nz-parliament-hansard",
      "legal_authority": "parliamentary_context",
      "role": "Local columnar Hansard text for parliamentary context, explanatory evidence, and later non-authoritative semantic review.",
      "used_for_rule_authority": false,
      "never_commit_payloads": true
    }
  ],
  "tables": [
    {
      "id": "legislation_provisions",
      "source_id": "corpus-legislation-nz",
      "required_columns": [
        "citation_path",
        "work_id",
        "work_title",
        "document_class",
        "expression_date",
        "version",
        "text",
        "source_path"
      ],
      "primary_join_key": "citation_path",
      "accepted_document_classes": [
        "act",
        "regulation",
        "order",
        "secondary_legislation",
        "bill",
        "sop"
      ],
      "normalized_record_shape": "data/corpus/provisions/nz/<document_class>/<run-id>.jsonl"
    },
    {
      "id": "hansard_speeches",
      "source_id": "corpus-nz-hansard",
      "required_columns": [
        "sitting_date",
        "chamber",
        "speaker_name",
        "debate_title",
        "speech_id",
        "text",
        "source_path"
      ],
      "primary_join_key": "source_path",
      "normalized_record_shape": "data/corpus/provisions/nz/hansard/<run-id>.jsonl"
    }
  ],
  "normalized_output_paths": {
    "legislation_provisions": "data/corpus/provisions/nz/<document_class>/<run-id>.jsonl",
    "legislation_inventory": "data/corpus/inventory/nz/<document_class>/<run-id>.json",
    "hansard_context": "data/corpus/provisions/nz/hansard/<run-id>.jsonl"
