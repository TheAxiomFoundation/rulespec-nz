# Binary files: no textual diff or merge. The encoder's trusted git wrapper
# refuses content-transforming attributes (text, eol, crlf, filter, ident,
# working-tree-encoding), so `binary` (which unsets text) is spelled out.
*.pyc -diff -merge
*.pyd -diff -merge
*.png -diff -merge
*.jpg -diff -merge
*.ico -diff -merge
*.pdf -diff -merge

# Rust build artifacts
rulespec-nz/target/** linguist-generated=true
target/** linguist-generated=true

# Generated coverage artifacts
__pycache__/** linguist-generated=true
.pytest_cache/** linguist-generated=true
.ruff_cache/** linguist-generated=true
